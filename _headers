# Cache foto per 1 anno
/foto/*
  Cache-Control: public, max-age=31536000, immutable

# Cache font
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# No cache per data.json — deve essere sempre fresco
/data.json
  Cache-Control: no-cache, no-store, must-revalidate

# HTML — cache breve
/*.html
  Cache-Control: public, max-age=60
